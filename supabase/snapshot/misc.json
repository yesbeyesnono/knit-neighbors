 "views": [
  {
   "v": "custom_technique_stats",
   "def": " SELECT lower(t.t) AS name,\n    count(*) AS uses\n   FROM works w,\n    LATERAL unnest(w.custom_techniques) t(t)\n  GROUP BY (lower(t.t))\n  ORDER BY (count(*)) DESC;"
  }
 ],
